<script>
(function () {
  // ================= SAMPLE QUESTION CHIPS =================
  var SAMPLE_QUESTIONS = {
    'Math': ['Why do we flip the sign dividing by a negative?', 'What is the volume of a cube?', 'Explain the Pythagoras theorem'],
    'Science': ['What is the structure of an atom?', 'Why does ice float on water?', 'What is a chemical bond?'],
    'Physics': ['What is Newton\u2019s second law?', 'Explain force as a vector', 'Why do we feel weightless in a lift falling fast?'],
    'Chemistry': ['What is a covalent bond?', 'Explain the structure of a water molecule', 'What is the periodic table?'],
    'Biology': ['What is inside a plant cell?', 'Explain what DNA does', 'How does photosynthesis work?'],
    'English': ['What is the difference between a metaphor and a simile?', 'Explain active vs passive voice', 'What makes a good thesis statement?'],
    'History': ['Why did the Indian independence movement start?', 'What caused World War 1?', 'Explain the Mughal administration'],
    'Geography': ['Why do we have seasons?', 'What causes monsoons in India?', 'Explain plate tectonics'],
    'Civics': ['What is the difference between a state and a nation?', 'Explain separation of powers', 'What is federalism?'],
    'Economics': ['What is inflation?', 'Explain demand and supply', 'What is GDP?'],
    'Computer Science': ['What is a variable?', 'Explain how a for-loop works', 'What is the difference between RAM and storage?'],
    'Environmental Science': ['What is the greenhouse effect?', 'Explain the water cycle', 'What is biodiversity?']
  };

  // ================= 3D CONCEPT FRAMEWORK =================
  var CONCEPT_MODELS = [
    { name: 'Cube', keywords: ['cube', 'square prism', 'volume of a cube'],
      build: function (THREE) {
        var g = new THREE.Group();
        var geo = new THREE.BoxGeometry(1.4, 1.4, 1.4);
        g.add(new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: 0xd9552c, roughness: 0.6 })));
        g.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo), new THREE.LineBasicMaterial({ color: 0xfff3e8 })));
        return g;
      } },
    { name: 'Sphere', keywords: ['sphere', 'ball', 'globe', 'volume of a sphere'],
      build: function (THREE) {
        var g = new THREE.Group();
        g.add(new THREE.Mesh(new THREE.SphereGeometry(1, 24, 24), new THREE.MeshStandardMaterial({ color: 0x4a90a4, roughness: 0.5 })));
        return g;
      } },
    { name: 'Cone', keywords: ['cone', 'volume of a cone'],
      build: function (THREE) {
        var g = new THREE.Group();
        g.add(new THREE.Mesh(new THREE.ConeGeometry(1, 1.8, 24), new THREE.MeshStandardMaterial({ color: 0xe8a33d, roughness: 0.5 })));
        return g;
      } },
    { name: 'Cylinder', keywords: ['cylinder', 'volume of a cylinder'],
      build: function (THREE) {
        var g = new THREE.Group();
        g.add(new THREE.Mesh(new THREE.CylinderGeometry(0.9, 0.9, 1.8, 24), new THREE.MeshStandardMaterial({ color: 0x6b8f85, roughness: 0.5 })));
        return g;
      } },
    { name: 'Pyramid', keywords: ['pyramid', 'square pyramid'],
      build: function (THREE) {
        var g = new THREE.Group();
        var mesh = new THREE.Mesh(new THREE.ConeGeometry(1.1, 1.6, 4), new THREE.MeshStandardMaterial({ color: 0xc9a24a, roughness: 0.6 }));
        mesh.rotation.y = Math.PI / 4;
        g.add(mesh);
        return g;
      } },
    { name: 'Pythagoras triangle', keywords: ['pythagoras', 'right triangle', 'hypotenuse'],
      build: function (THREE) {
        var g = new THREE.Group();
        var shape = new THREE.Shape();
        shape.moveTo(-1, -0.6); shape.lineTo(1, -0.6); shape.lineTo(-1, 0.9); shape.lineTo(-1, -0.6);
        var geo = new THREE.ExtrudeGeometry(shape, { depth: 0.15, bevelEnabled: false });
        g.add(new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ color: 0xd9552c, roughness: 0.6, side: THREE.DoubleSide })));
        return g;
      } },
    { name: 'Atom', keywords: ['atom', 'electron', 'proton', 'neutron', 'nucleus', 'bohr model'],
      build: function (THREE) {
        var g = new THREE.Group();
        g.add(new THREE.Mesh(new THREE.SphereGeometry(0.3, 16, 16), new THREE.MeshStandardMaterial({ color: 0xd9552c })));
        var orbitColors = [0x4a90a4, 0xe8a33d, 0x6b8f85];
        g.userData.electrons = [];
        for (var i = 0; i < 3; i++) {
          var ring = new THREE.Mesh(new THREE.TorusGeometry(0.9 + i * 0.35, 0.015, 8, 64), new THREE.MeshBasicMaterial({ color: 0x9fb3ab }));
          ring.rotation.x = Math.PI / 2 + i * 0.6; ring.rotation.y = i * 0.9;
          g.add(ring);
          var electron = new THREE.Mesh(new THREE.SphereGeometry(0.1, 12, 12), new THREE.MeshStandardMaterial({ color: orbitColors[i] }));
          electron.userData.orbitRadius = 0.9 + i * 0.35;
          electron.userData.orbitSpeed = 0.02 + i * 0.01;
          g.add(electron);
          g.userData.electrons.push(electron);
        }
        return g;
      },
      animate: function (group, t) {
        (group.userData.electrons || []).forEach(function (e, i) {
          var r = e.userData.orbitRadius, speed = e.userData.orbitSpeed;
          e.position.set(Math.cos(t * speed * 60 + i) * r, Math.sin(t * speed * 60 + i) * r * 0.4, Math.sin(t * speed * 40 + i) * r * 0.5);
        });
      } },
    { name: 'Water molecule', keywords: ['molecule', 'water molecule', 'h2o', 'covalent bond', 'chemical bond'],
      build: function (THREE) {
        var g = new THREE.Group();
        g.add(new THREE.Mesh(new THREE.SphereGeometry(0.4, 20, 20), new THREE.MeshStandardMaterial({ color: 0xd9552c })));
        [[0.9, 0.6, 0], [-0.9, 0.6, 0]].forEach(function (pos) {
          var h = new THREE.Mesh(new THREE.SphereGeometry(0.25, 16, 16), new THREE.MeshStandardMaterial({ color: 0xeef3ea }));
          h.position.set(pos[0], pos[1], pos[2]);
          g.add(h);
          var dir = new THREE.Vector3(pos[0], pos[1], pos[2]);
          var bond = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, dir.length(), 8), new THREE.MeshStandardMaterial({ color: 0x9fb3ab }));
          bond.position.set(pos[0] / 2, pos[1] / 2, pos[2] / 2);
          bond.lookAt(dir); bond.rotateX(Math.PI / 2);
          g.add(bond);
        });
        return g;
      } },
    { name: 'DNA helix', keywords: ['dna', 'double helix', 'genetics', 'chromosome', 'nucleotide'],
      build: function (THREE) {
        var g = new THREE.Group();
        var turns = 3, pointsPerTurn = 14, radius = 0.6, height = 2.4;
        var strandA = [], strandB = [];
        for (var i = 0; i <= turns * pointsPerTurn; i++) {
          var t = i / pointsPerTurn * Math.PI * 2;
          var y = (i / (turns * pointsPerTurn)) * height - height / 2;
          strandA.push(new THREE.Vector3(Math.cos(t) * radius, y, Math.sin(t) * radius));
          strandB.push(new THREE.Vector3(Math.cos(t + Math.PI) * radius, y, Math.sin(t + Math.PI) * radius));
        }
        [strandA, strandB].forEach(function (pts, idx) {
          var curve = new THREE.CatmullRomCurve3(pts);
          var tube = new THREE.TubeGeometry(curve, 80, 0.06, 8, false);
          g.add(new THREE.Mesh(tube, new THREE.MeshStandardMaterial({ color: idx === 0 ? 0x4a90a4 : 0xe8a33d })));
        });
        for (var j = 0; j < strandA.length; j += 3) {
          var rung = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, strandA[j].distanceTo(strandB[j]), 6), new THREE.MeshStandardMaterial({ color: 0x9fb3ab }));
          var mid = strandA[j].clone().add(strandB[j]).multiplyScalar(0.5);
          rung.position.copy(mid); rung.lookAt(strandB[j]); rung.rotateX(Math.PI / 2);
          g.add(rung);
        }
        return g;
      } },
    { name: 'Plant cell', keywords: ['cell', 'plant cell', 'organelle', 'cell wall', 'chloroplast', 'mitochondria'],
      build: function (THREE) {
        var g = new THREE.Group();
        g.add(new THREE.Mesh(new THREE.SphereGeometry(1.3, 24, 24), new THREE.MeshStandardMaterial({ color: 0x9fd0a0, transparent: true, opacity: 0.35 })));
        var nucleus = new THREE.Mesh(new THREE.SphereGeometry(0.4, 16, 16), new THREE.MeshStandardMaterial({ color: 0x4a5fa4 }));
        nucleus.position.set(0.2, 0.1, 0);
        g.add(nucleus);
        [[0.7, 0.5, 0.3], [-0.6, -0.4, 0.4], [-0.3, 0.6, -0.5], [0.5, -0.6, -0.3]].forEach(function (p) {
          var o = new THREE.Mesh(new THREE.SphereGeometry(0.18, 12, 12), new THREE.MeshStandardMaterial({ color: 0x3b8f4a }));
          o.position.set(p[0], p[1], p[2]);
          g.add(o);
        });
        return g;
      } },
    { name: 'Force vector', keywords: ['force', 'vector', 'newton', 'acceleration', 'resultant'],
      build: function (THREE) {
        var g = new THREE.Group();
        var origin = new THREE.Vector3(0, 0, 0);
        g.add(new THREE.ArrowHelper(new THREE.Vector3(1, 0.3, 0).normalize(), origin, 1.6, 0xd9552c, 0.3, 0.18));
        g.add(new THREE.ArrowHelper(new THREE.Vector3(0.2, 1, 0.3).normalize(), origin, 1.3, 0x4a90a4, 0.3, 0.18));
        g.add(new THREE.Mesh(new THREE.SphereGeometry(0.08, 12, 12), new THREE.MeshStandardMaterial({ color: 0xeef3ea })));
        return g;
      } },
    { name: 'Water cycle', keywords: ['water cycle', 'evaporation', 'monsoon', 'precipitation'],
      build: function (THREE) {
        var g = new THREE.Group();
        var base = new THREE.Mesh(new THREE.CylinderGeometry(1.2, 1.2, 0.1, 32), new THREE.MeshStandardMaterial({ color: 0x4a90a4 }));
        base.position.y = -0.8;
        g.add(base);
        for (var i = 0; i < 5; i++) {
          var drop = new THREE.Mesh(new THREE.SphereGeometry(0.08, 10, 10), new THREE.MeshStandardMaterial({ color: 0x9fd0e0 }));
          var angle = (i / 5) * Math.PI * 2;
          drop.position.set(Math.cos(angle) * 0.8, 0.3 + i * 0.15, Math.sin(angle) * 0.8);
          g.add(drop);
        }
        return g;
      } }
  ];

  var NO_VISUAL_MODEL = {
    name: 'No 3D visual for this topic',
    build: function (THREE) {
      var g = new THREE.Group();
      var geo = new THREE.IcosahedronGeometry(1, 0);
      g.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo), new THREE.LineBasicMaterial({ color: 0x5a6b64 })));
      return g;
    }
  };

  function scanConceptKeywords(text) {
    var lower = text.toLowerCase();
    for (var i = 0; i < CONCEPT_MODELS.length; i++) {
      var kws = CONCEPT_MODELS[i].keywords;
      for (var j = 0; j < kws.length; j++) {
        if (lower.indexOf(kws[j]) !== -1) return CONCEPT_MODELS[i];
      }
    }
    return null;
  }

  // ================= THREE.JS SCENE SETUP =================
  var conceptPanel = document.getElementById('conceptPanel');
  var conceptLabel = document.getElementById('conceptLabel');
  var conceptHint = document.getElementById('conceptHint');

  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(45, conceptPanel.clientWidth / conceptPanel.clientHeight, 0.1, 100);
  camera.position.set(0, 0.6, 4.2);

  var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(conceptPanel.clientWidth, conceptPanel.clientHeight);
  conceptPanel.insertBefore(renderer.domElement, conceptLabel);

  scene.add(new THREE.AmbientLight(0xffffff, 0.5));
  var dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
  dirLight.position.set(3, 4, 5);
  scene.add(dirLight);

  var currentGroup = null, currentModel = null;

  function setModel(modelDef) {
    if (currentGroup) scene.remove(currentGroup);
    currentGroup = modelDef.build(THREE);
    scene.add(currentGroup);
    currentModel = modelDef;
    conceptLabel.textContent = modelDef.name;
  }
  setModel(CONCEPT_MODELS[0]);

  var isDragging = false, prevX = 0, prevY = 0, autoRotate = true;
  renderer.domElement.addEventListener('mousedown', function (e) { isDragging = true; autoRotate = false; prevX = e.clientX; prevY = e.clientY; });
  window.addEventListener('mouseup', function () { isDragging = false; });
  window.addEventListener('mousemove', function (e) {
    if (!isDragging || !currentGroup) return;
    currentGroup.rotation.y += (e.clientX - prevX) * 0.01;
    currentGroup.rotation.x += (e.clientY - prevY) * 0.01;
    prevX = e.clientX; prevY = e.clientY;
  });

  var clock = new THREE.Clock();
  function animate() {
    requestAnimationFrame(animate);
    var t = clock.getElapsedTime();
    if (currentGroup && autoRotate) currentGroup.rotation.y += 0.006;
    if (currentModel && currentModel.animate) currentModel.animate(currentGroup, t);
    renderer.render(scene, camera);
  }
  animate();

  // ================= SHARED STATE =================
  var history = [];              // full conversation sent to Claude
  var topicsCovered = [];        // short labels for session progress
  var quizStats = { correct: 0, total: 0 };

  var chatWindow = document.getElementById('chatWindow');
  var sendBtn = document.getElementById('sendBtn');
  var userInput = document.getElementById('userInput');
  var topicsBadge = document.getElementById('topicsBadge');
  var quizBadge = document.getElementById('quizBadge');
  var languageSelect = document.getElementById('language');
  var languageOther = document.getElementById('languageOther');
  var chipsRow = document.getElementById('chipsRow');
  var subjectSelect = document.getElementById('subject');
  var gradeSelect = document.getElementById('grade');
  var n8nWebhookInput = document.getElementById('n8nWebhook');

  // ---- n8n integration: fire-and-forget POST to a webhook you configure ----
  // Build a workflow in n8n starting with a "Webhook" trigger node at this URL.
  // From there you can add a Google Sheets node (log the row), an Email/WhatsApp
  // node (notify a parent), or a database node — all without touching this file.
  function sendToN8n(eventType, payload) {
    var url = n8nWebhookInput.value.trim();
    if (!url) return; // no webhook configured — skip silently
    var body = Object.assign({
      event: eventType,
      timestamp: new Date().toISOString(),
      subject: subjectSelect.value,
      grade: gradeSelect.value,
      language: getSelectedLanguage()
    }, payload);

    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).catch(function (err) {
      console.warn('n8n webhook call failed (this does not affect the tutor):', err);
    });
  }

  languageSelect.addEventListener('change', function () {
    languageOther.style.display = languageSelect.value === 'other' ? 'block' : 'none';
    if (languageSelect.value === 'other') languageOther.focus();
  });

  function getSelectedLanguage() {
    if (languageSelect.value === 'other') return languageOther.value.trim() || 'English';
    return languageSelect.value;
  }

  function updateStats() {
    topicsBadge.textContent = topicsCovered.length + (topicsCovered.length === 1 ? ' topic today' : ' topics today');
    quizBadge.textContent = 'Quiz: ' + quizStats.correct + '/' + quizStats.total;
  }

  function renderChips() {
    chipsRow.innerHTML = '';
    var qs = SAMPLE_QUESTIONS[subjectSelect.value] || [];
    qs.forEach(function (q) {
      var chip = document.createElement('button');
      chip.className = 'chip';
      chip.textContent = q;
      chip.addEventListener('click', function () {
        userInput.value = q;
        sendMessage();
      });
      chipsRow.appendChild(chip);
    });
  }
  subjectSelect.addEventListener('change', renderChips);
  renderChips();

  function addMessage(role, text) {
    var div = document.createElement('div');
    div.className = 'msg ' + role;
    div.textContent = text;
    chatWindow.appendChild(div);
    chatWindow.scrollTop = chatWindow.scrollHeight;
    return div;
  }

  function showTyping() {
    var div = document.createElement('div');
    div.className = 'msg tutor typing-dots';
    div.id = 'typingIndicator';
    div.innerHTML = '<span></span><span></span><span></span>';
    chatWindow.appendChild(div);
    chatWindow.scrollTop = chatWindow.scrollHeight;
    return div;
  }
  function removeTyping() {
    var el = document.getElementById('typingIndicator');
    if (el) el.remove();
  }

  // ---- grade-aware, creative system prompt ----
  function buildSystemPrompt() {
    var subject = subjectSelect.value;
    var grade = parseInt(gradeSelect.value, 10);
    var language = getSelectedLanguage();

    var toneLine;
    if (grade <= 8) {
      toneLine = 'Teach playfully: open with a tiny relatable story or vivid everyday analogy (cricket, cooking, markets, festivals) before the formal explanation. Warm and fun tone.';
    } else if (grade <= 10) {
      toneLine = 'Teach with one short relatable analogy to hook interest, then move quickly into a clear, structured explanation. Balanced tone — friendly but focused.';
    } else {
      toneLine = 'Teach in an exam-focused way: lead with a precise definition or formula, keep any analogy to one brief line, emphasize application to typical exam questions, and note common mistakes students make. Concise, respectful tone — this student is preparing for board exams.';
    }

    return [
      'You are an ' + subject + ' tutor for a grade ' + grade + ' student.',
      'Explain in ' + language + ', using short sentences.',
      toneLine,
      'Ask one short question first to check what the student already knows.',
      'End with a small follow-up question or a mini-challenge to try.',
      'Keep each reply under 130 words.'
    ].join(' ');
  }

  async function callClaude(systemPrompt, messages, maxTokens) {
    var response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: maxTokens || 1000, system: systemPrompt, messages: messages })
    });
    var data = await response.json();
    return (data.content || []).map(function (b) { return b.type === 'text' ? b.text : ''; }).join('\n').trim();
  }

  function shortTopicLabel(text) {
    var words = text.trim().split(/\s+/).slice(0, 6).join(' ');
    return words.length < text.trim().length ? words + '…' : words;
  }

  function updateConceptPanel(combinedText) {
    var match = scanConceptKeywords(combinedText);
    if (match) {
      setModel(match);
      autoRotate = true;
      conceptHint.textContent = 'Drag to rotate. Showing: ' + match.name.toLowerCase() + '.';
    } else {
      setModel(NO_VISUAL_MODEL);
      conceptHint.textContent = 'No 3D visual for this topic — see the explanation above instead.';
    }
  }

  // ---- render a tutor reply + its action buttons (explain differently / quiz) ----
  function renderTutorReply(replyText, lastUserQuestion) {
    var block = document.createElement('div');
    block.className = 'tutor-block';

    var bubble = document.createElement('div');
    bubble.className = 'msg tutor';
    bubble.textContent = replyText;
    block.appendChild(bubble);

    var actions = document.createElement('div');
    actions.className = 'tutor-actions';

    var explainBtn = document.createElement('button');
    explainBtn.textContent = 'Explain differently ↻';
    explainBtn.addEventListener('click', function () {
      explainDifferently(lastUserQuestion, explainBtn);
    });

    var quizBtn = document.createElement('button');
    quizBtn.textContent = 'Quick check ✎';
    quizBtn.addEventListener('click', function () {
      startQuiz(lastUserQuestion, replyText, quizBtn);
    });

    actions.appendChild(explainBtn);
    actions.appendChild(quizBtn);
    block.appendChild(actions);

    chatWindow.appendChild(block);
    chatWindow.scrollTop = chatWindow.scrollHeight;
  }

  // ---- main "ask a question" flow ----
  async function sendMessage() {
    var text = userInput.value.trim();
    if (!text) return;

    addMessage('student', text);
    history.push({ role: 'user', content: text });
    userInput.value = '';
    sendBtn.disabled = true;
    showTyping();

    try {
      var replyText = await callClaude(buildSystemPrompt(), history, 1000);
      removeTyping();
      if (!replyText) replyText = 'Sorry, something went wrong on my end. Try asking again.';

      history.push({ role: 'assistant', content: replyText });
      renderTutorReply(replyText, text);
      updateConceptPanel(text + ' ' + replyText);

      topicsCovered.push(shortTopicLabel(text));
      updateStats();
      sendToN8n('topic_covered', { topic: shortTopicLabel(text) });
    } catch (err) {
      removeTyping();
      addMessage('system-note', 'Network error — please try again.');
      console.error('Tutor API error:', err);
    } finally {
      sendBtn.disabled = false;
      userInput.focus();
    }
  }

  // ---- "explain differently" flow ----
  async function explainDifferently(lastUserQuestion, triggerBtn) {
    triggerBtn.disabled = true;
    addMessage('system-note', 'Asking for another way to explain this ↻');
    var typingEl = showTyping();

    var hiddenInstruction = 'Please explain "' + lastUserQuestion + '" again, but use a COMPLETELY different analogy or method than before. Do not repeat the previous explanation.';
    var turnHistory = history.concat([{ role: 'user', content: hiddenInstruction }]);

    try {
      var replyText = await callClaude(buildSystemPrompt(), turnHistory, 1000);
      removeTyping();
      if (!replyText) replyText = 'Sorry, something went wrong. Try again.';

      history.push({ role: 'user', content: hiddenInstruction });
      history.push({ role: 'assistant', content: replyText });
      renderTutorReply(replyText, lastUserQuestion);
      updateConceptPanel(lastUserQuestion + ' ' + replyText);
    } catch (err) {
      removeTyping();
      addMessage('system-note', 'Network error — please try again.');
      console.error('Explain-differently error:', err);
    } finally {
      triggerBtn.disabled = false;
    }
  }

  // ---- quiz check-in flow ----
  async function startQuiz(lastUserQuestion, tutorReply, triggerBtn) {
    triggerBtn.disabled = true;
    var typingEl = showTyping();

    var quizSystem = 'You write one short multiple-choice quiz question to check understanding of a concept just taught. ' +
      'Respond with ONLY valid JSON, no markdown fences, no preamble, in this exact shape: ' +
      '{"question":"...","options":["...","...","...","..."],"correctIndex":0}. ' +
      'Exactly 4 options, only one correct. Keep the question and options short.';
    var quizUser = 'Topic: ' + lastUserQuestion + '\nExplanation given: ' + tutorReply;

    try {
      var raw = await callClaude(quizSystem, [{ role: 'user', content: quizUser }], 300);
      removeTyping();
      var clean = raw.replace(/```json|```/g, '').trim();
      var quiz = JSON.parse(clean);
      renderQuizCard(quiz);
    } catch (err) {
      removeTyping();
      addMessage('system-note', 'Could not build a quiz for this just now — try again.');
      console.error('Quiz error:', err);
    } finally {
      triggerBtn.disabled = false;
    }
  }

  function renderQuizCard(quiz) {
    var card = document.createElement('div');
    card.className = 'quiz-card';

    var title = document.createElement('p');
    title.className = 'q-title';
    title.textContent = quiz.question;
    card.appendChild(title);

    var feedback = document.createElement('div');
    feedback.className = 'quiz-feedback';

    quiz.options.forEach(function (opt, idx) {
      var btn = document.createElement('button');
      btn.className = 'quiz-option';
      btn.textContent = opt;
      btn.addEventListener('click', function () {
        var allBtns = card.querySelectorAll('.quiz-option');
        allBtns.forEach(function (b) { b.disabled = true; });

        quizStats.total++;
        if (idx === quiz.correctIndex) {
          btn.classList.add('correct');
          quizStats.correct++;
          feedback.textContent = 'Correct! Nice work.';
        } else {
          btn.classList.add('incorrect');
          allBtns[quiz.correctIndex].classList.add('correct');
          feedback.textContent = 'Not quite — the correct answer is highlighted.';
        }
        updateStats();
        sendToN8n('quiz_answered', {
          question: quiz.question,
          correct: idx === quiz.correctIndex,
          score_so_far: quizStats.correct + '/' + quizStats.total
        });
      });
      card.appendChild(btn);
    });

    card.appendChild(feedback);
    chatWindow.appendChild(card);
    chatWindow.scrollTop = chatWindow.scrollHeight;
  }

  sendBtn.addEventListener('click', sendMessage);
  userInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });

  updateStats();
})();
</script>